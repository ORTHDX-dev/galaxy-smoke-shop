    "content":{"type":"content","label":"Site content","groups":[
      {"label":"Site style","instances":[{"id":"theme","label":"Colors and corners","file":"content/theme.json","path":"","editable":[{"key":"brand","label":"Brand color","type":"color"},{"key":"brandText","label":"Text on brand color","type":"color"},{"key":"radius","label":"Corner roundness","type":"range","min":0,"max":24,"step":1,"unit":"px"}]}]},
      {"label":"Buttons","instances":[{"id":"hero-button","label":"Homepage / Hero button","file":"content/home.json","path":"hero.primary","editable":["label","url",{"key":"variant","label":"Style","type":"choice","options":["primary","secondary","link"]}]},{"id":"cta-button","label":"Homepage / Bottom button","file":"content/home.json","path":"cta.button","editable":["label","url",{"key":"variant","label":"Style","type":"choice","options":["primary","secondary","link"]}]},{"id":"footer-button","label":"Footer / Contact button","file":"content/site.json","path":"footer.contact","editable":["label","url",{"key":"variant","label":"Style","type":"choice","options":["primary","secondary","link"]}]}]},
      {"label":"Text","instances":[{"id":"hero-text","label":"Homepage / Hero","file":"content/home.json","path":"hero","editable":["heading",{"key":"subheading","label":"Subheading","type":"textarea","maxLength":300}]},{"id":"cta-text","label":"Homepage / Bottom","file":"content/home.json","path":"cta","editable":["heading"]}]},
      {"label":"Business info","instances":[{"id":"business","label":"Phone, email, address, hours","file":"content/site.json","path":"business","editable":[{"key":"phone","label":"Phone","type":"text","maxLength":30},{"key":"email","label":"Email","type":"email","maxLength":120},{"key":"address","label":"Address","type":"text","maxLength":200},{"key":"hours","label":"Hours","type":"text","maxLength":100},{"key":"lateHours","label":"Late hours","type":"text","maxLength":100}]}]}
    ]}
  }
